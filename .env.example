# Vulmon Recon Essentials — copy to `.env` next to docker-compose.yml (recon-essentials.sh and
# recon-essentials.ps1 do this). Everything not listed here has a built-in default; you never need more.

# Required. The scripts generate one; for a manual setup pick a long random value.
POSTGRES_PASSWORD=change-me

# The address people open in the browser, with http:// and the port. A LAN IP or a host name is
# fine (http://192.168.1.20:8080). Sign-in, invitation and password-reset links use it.
# WEB_PORT is the port the web is published on: it must be the port in APP_URL.
# WEB_BIND is who can reach that port: 127.0.0.1 is this computer only, 0.0.0.0 the network too.
# On Linux, Docker publishes the port past ufw, so ufw rules do not limit it: WEB_BIND does.
# To change them, run `./recon-essentials.sh address` (Windows: `recon-essentials.cmd address`),
# or edit them here and run `docker compose up -d`.
APP_URL=http://localhost:8080
WEB_PORT=8080
WEB_BIND=127.0.0.1

# The release to run. Both images, the web and the engine, take this one number, so they cannot
# come from different releases. The scripts pin it; `./recon-essentials.sh upgrade`
# (Windows: `recon-essentials.cmd upgrade`) moves it.
RECON_VERSION=1.0.1

# Optional.
# POSTGRES_USER=recon
# POSTGRES_DB=recon
# LOG_LEVEL=info
# Behind a reverse proxy that terminates HTTPS (nginx, Caddy, Traefik): the app then takes the
# client address from the proxy's X-Real-IP / X-Forwarded-For headers for its sign-in limits.
# Leave unset when browsers reach the web port directly, or any client could pick its own address.
# A proxy on the same computer reaches the web on 127.0.0.1, so WEB_BIND can stay 127.0.0.1.
# RECON_TRUST_PROXY=1
# Logs are kept in two Docker volumes (weblogs, enginelogs). To read them as plain files instead,
# point them at host folders (on Windows for example C:/recon/logs/web). On Linux the web's folder
# must be writable by uid 1001.
# ESSENTIALS_LOG_DIR=./logs/web
# ESSENTIALS_ENGINE_LOG_DIR=./logs/engine
