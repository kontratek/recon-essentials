# Vulmon Recon Essentials — copy to `.env` next to docker-compose.yml (install.sh does this).
# Everything not listed here has a built-in default; you never need more than these.

# Required. install.sh generates one; for a manual setup pick a long random value.
POSTGRES_PASSWORD=change-me

# The address people open in the browser — a LAN IP or hostname is fine (http://192.168.1.20:8080).
# Sign-in and invitation links use it; change it here and restart when the address changes.
APP_URL=http://localhost:8080
WEB_PORT=8080

# The release to run. Both images, the web and the engine, take this one number, so they cannot
# come from different releases. install.sh pins it; `bash install.sh upgrade` moves it.
RECON_VERSION=1.0.0

# Optional.
# POSTGRES_USER=recon
# POSTGRES_DB=recon
# LOG_LEVEL=info
# Behind a reverse proxy that terminates HTTPS (nginx, Caddy, Traefik): the app then takes the
# client address from the proxy's X-Real-IP / X-Forwarded-For headers for its sign-in limits.
# Leave unset when browsers reach the web port directly, or any client could pick its own address.
# RECON_TRUST_PROXY=1
# Logs are kept in two Docker volumes (weblogs, enginelogs). To read them as plain files instead,
# point them at host folders — on Linux the web's folder must be writable by uid 1001.
# ESSENTIALS_LOG_DIR=./logs/web
# ESSENTIALS_ENGINE_LOG_DIR=./logs/engine
